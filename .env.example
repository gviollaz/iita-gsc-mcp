# --- MCP auth (REQUIRED) ---------------------------------------------------
# Without this the server refuses to start. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Auth mode. Default true (OAuth 2.1), matching iita-googleads in production.
# Set to false to use URL-token auth for clients that can't do OAuth.
MCP_OAUTH_ENABLED=true

# --- Google Search Console -------------------------------------------------
GSC_SITE_URL=https://iita.com.ar/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Server ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO

# Extra hostnames accepted by the DNS-rebinding check, comma separated.
# Railway's own domain is picked up automatically.
# MCP_ALLOWED_HOSTS=

# Set to false only if host validation starts returning 421 after a domain
# change. Authentication is unaffected either way.
# MCP_DNS_REBINDING_PROTECTION=true
